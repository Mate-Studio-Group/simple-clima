{
  "expo": {
    "name": "Simple Clima",
    "slug": "simple-clima",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12182b",
    "primaryColor": "#3b82f6",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#12182b"
    },
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.margen.simpleclima",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#12182b"
      },
      "permissions": []
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
